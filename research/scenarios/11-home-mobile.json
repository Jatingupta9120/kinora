{
  "browser": {
    "mode": "launch",
    "executable_path": "/home/jatin/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome",
    "headless": true
  },
  "environment": {
    "viewport": {
      "width": 390,
      "height": 844,
      "device_scale_factor": 2
    },
    "locale": "en-US",
    "timezone": "Asia/Kolkata",
    "color_scheme": "dark",
    "reduced_motion": "reduce",
    "service_workers": "allow"
  },
  "start_url": {
    "url": "https://www.primevideo.com/"
  },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 6000
    }
  ],
  "capture": {
    "at_end": [
      "accessibility",
      "screenshot",
      "url"
    ],
    "events": [
      "network",
      "page-errors"
    ]
  }
}