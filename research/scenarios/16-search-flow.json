{
  "browser": {
    "mode": "launch",
    "executable_path": "/home/jatin/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome",
    "headless": true
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900,
      "device_scale_factor": 1
    },
    "locale": "en-US",
    "timezone": "Asia/Kolkata",
    "color_scheme": "dark",
    "reduced_motion": "reduce",
    "service_workers": "allow"
  },
  "start_url": {
    "url": "https://www.primevideo.com/"
  },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 4000
    },
    {
      "step_id": "open-search",
      "action": "click",
      "timeout_ms": 10000,
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Search Prime Video"
      }
    },
    {
      "step_id": "type-query",
      "action": "fill",
      "timeout_ms": 10000,
      "locator": {
        "kind": "css",
        "selector": "input[type='search'] >> visible=true"
      },
      "value": {
        "source": "literal",
        "value": "reacher"
      }
    },
    {
      "step_id": "typeahead",
      "action": "wait_for_timeout",
      "duration_ms": 2500
    },
    {
      "step_id": "submit",
      "action": "press",
      "timeout_ms": 10000,
      "locator": {
        "kind": "css",
        "selector": "input[type='search'] >> visible=true"
      },
      "key": "Enter"
    },
    {
      "step_id": "results",
      "action": "wait_for_timeout",
      "duration_ms": 5000
    }
  ],
  "capture": {
    "at_end": [
      "accessibility",
      "screenshot",
      "url"
    ],
    "events": [
      "network",
      "page-errors"
    ]
  }
}